{
  // O "name" precisa ser IDENTICO ao nome do Worker no dashboard da Cloudflare,
  // senao o deploy falha com erro de nome.
  "name": "adrianaspmu",

  "compatibility_date": "2026-08-10",

  // Entry point do Worker. Existe por causa de UM endpoint: /api/contact.
  "main": "./src/index.js",

  "assets": {
    "directory": "./",
    "not_found_handling": "404-page",
    "binding": "ASSETS",

    // O Worker so e invocado em /api/*. Qualquer outra URL continua
    // sendo servida direto pelos assets, sem passar por codigo.
    "run_worker_first": ["/api/*"]
  },

  // Envio nativo do Cloudflare Email Service. Sem restricao de
  // destino no binding: a restricao real ja existe na plataforma,
  // que so aceita enviar para enderecos VERIFICADOS da conta
  // (gratuito em qualquer plano). Os destinatarios ficam no secret
  // CONTACT_TO, fora do repo publico.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "vars": {
    // Origens aceitas pelo endpoint do formulario. Nao e segredo.
    "ALLOWED_ORIGINS": "https://adrianaspmu.com,https://www.adrianaspmu.com,https://adrianaspmu.pablodias2017.workers.dev",

    // Remetente. Precisa pertencer ao dominio de routing.
    "CONTACT_FROM": "Adriana's PMU Website <website@adrianaspmu.com>"
  },

  // Rate limit nativo, por IP, no endpoint do formulario.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true
  }
}
